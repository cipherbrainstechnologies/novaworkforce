{
  "name": "nova-workforce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "worker:start": "tsx worker/index.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "echo 'No seed script configured. Add prisma/seed.ts when domain models are ready.'"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.460.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.0",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
