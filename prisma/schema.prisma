generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Placeholder model for initial migration bootstrap.
/// Extend with payroll domain models as the portal is built out.
model DeploymentBootstrap {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
